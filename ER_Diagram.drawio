        <mxCell id="2" value="&lt;pre&gt;@startuml&#xa;skinparam monochrome false&#xa;skinparam linetype ortho&#xa;&#xa;entity &quot;Material&quot; as material {&#xa;  * Id : int &lt;&lt;PK&gt;&gt;&#xa;  --&#xa;  MaterialName : string&#xa;  Description : string&#xa;}&#xa;&#xa;entity &quot;BlanketModel&quot; as blanket {&#xa;  * Id : int &lt;&lt;PK&gt;&gt;&#xa;  --&#xa;  SKU : string&#xa;  ModelName : string&#xa;  * MaterialId : int &lt;&lt;FK&gt;&gt;&#xa;  Size : string&#xa;  Color : string&#xa;  UnitPrice : decimal&#xa;  IsActive : bool&#xa;}&#xa;&#xa;entity &quot;FactoryInventory&quot; as factory_inv {&#xa;  * Id : int &lt;&lt;PK&gt;&gt;&#xa;  --&#xa;  * BlanketModelId : int &lt;&lt;FK&gt;&gt;&#xa;  QuantityOnHand : int&#xa;  ReservedQuantity : int&#xa;  AvailableQuantity : int&#xa;  LastUpdated : datetime&#xa;}&#xa;&#xa;entity &quot;Distributor&quot; as distributor {&#xa;  * Id : int &lt;&lt;PK&gt;&gt;&#xa;  --&#xa;  DistributorName : string&#xa;  Email : string&#xa;  Phone : string&#xa;  Address : string&#xa;}&#xa;&#xa;entity &quot;DistributorInventory&quot; as dist_inv {&#xa;  * Id : int &lt;&lt;PK&gt;&gt;&#xa;  --&#xa;  * DistributorId : int &lt;&lt;FK&gt;&gt;&#xa;  * BlanketModelId : int &lt;&lt;FK&gt;&gt;&#xa;  QuantityOnHand : int&#xa;  ReservedQuantity : int&#xa;  AvailableQuantity : int&#xa;}&#xa;&#xa;entity &quot;Seller&quot; as seller {&#xa;  * Id : int &lt;&lt;PK&gt;&gt;&#xa;  --&#xa;  * DistributorId : int &lt;&lt;FK&gt;&gt;&#xa;  SellerName : string&#xa;  StoreType : string&#xa;  Email : string&#xa;}&#xa;&#xa;entity &quot;SellerInventory&quot; as seller_inv {&#xa;  * Id : int &lt;&lt;PK&gt;&gt;&#xa;  --&#xa;  * SellerId : int &lt;&lt;FK&gt;&gt;&#xa;  * BlanketModelId : int &lt;&lt;FK&gt;&gt;&#xa;  QuantityOnHand : int&#xa;  ReservedQuantity : int&#xa;  AvailableQuantity : int&#xa;}&#xa;&#xa;entity &quot;CustomerOrder&quot; as cust_order {&#xa;  * Id : int &lt;&lt;PK&gt;&gt;&#xa;  --&#xa;  OrderNumber : string&#xa;  CustomerId : int &lt;&lt;FK&gt;&gt;&#xa;  SellerId : int &lt;&lt;FK&gt;&gt;&#xa;  Status : string&#xa;  OrderDate : datetime&#xa;  TotalAmount : decimal&#xa;}&#xa;&#xa;entity &quot;AvailabilityRequest&quot; as avail_req {&#xa;  * Id : int &lt;&lt;PK&gt;&gt;&#xa;  --&#xa;  RequestNumber : string&#xa;  CustomerOrderId : int &lt;&lt;FK&gt;&gt;&#xa;  BlanketModelId : int &lt;&lt;FK&gt;&gt;&#xa;  SellerId : int &lt;&lt;FK&gt;&gt;&#xa;  DistributorId : int &lt;&lt;FK&gt;&gt;&#xa;  RequestedQuantity : int&#xa;  RequestLevel : string&#xa;  Status : string&#xa;}&#xa;&#xa;entity &quot;TransferOrder&quot; as transfer {&#xa;  * Id : int &lt;&lt;PK&gt;&gt;&#xa;  --&#xa;  TransferNumber : string&#xa;  CustomerOrderId : int &lt;&lt;FK&gt;&gt;&#xa;  FromDistributorId : int &lt;&lt;FK&gt;&gt;&#xa;  ToSellerId : int &lt;&lt;FK&gt;&gt;&#xa;  Status : string&#xa;}&#xa;&#xa;material ||--o{ blanket&#xa;blanket ||--o{ factory_inv&#xa;blanket ||--o{ dist_inv&#xa;blanket ||--o{ seller_inv&#xa;distributor ||--o{ seller&#xa;distributor ||--o{ dist_inv&#xa;distributor ||--o{ avail_req&#xa;seller ||--o{ seller_inv&#xa;seller ||--o{ cust_order&#xa;seller ||--o{ avail_req&#xa;cust_order ||--o{ avail_req&#xa;cust_order ||--o{ transfer&#xa;@enduml&lt;/pre&gt;" style="shape=mxgraph.sysml.plantuml;whiteSpace=wrap;html=1;" vertex="1" parent="1">
